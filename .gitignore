# Unity 기본 (github/gitignore Unity.gitignore 기준)
# Unity가 자동으로 다시 만드는 폴더. 용량이 크고 PC마다 달라서 올리지 않는다.
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Asset Store 도구
/[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio / VS Code / Rider 캐시와 자동 생성 파일
.vs/
.vscode/
.idea/
.gradle/
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D 메타 파일 중 디버그용
*.pidb.meta
*.pdb.meta
*.mdb.meta

# 크래시 리포트
sysinfo.txt

# 빌드 결과물
*.apk
*.aab
*.unitypackage
*.app

# Gradle cache (Android)
.gradle

# 자동 생성되는 스트리밍 에셋
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# 비밀 값 (서버 주소·테스트 계정 등을 파일로 둘 경우)
.env
.env.*
